{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusTimer",
  "version": "0.1.0",
  "identifier": "com.focustimer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FocusTimer",
        "width": 320,
        "height": 380,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "常驻菜单栏的专注计时器",
    "longDescription": "工作时段满 1 小时就提醒你休息，不确认则每 10 分钟重复提醒一次；休息结束自动开始下一个工作时段。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
